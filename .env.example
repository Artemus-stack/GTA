# Copy to .env and fill in. Never commit .env.

# Twitch developer app (https://dev.twitch.tv/console/apps): finds the top
# streams and their VODs. Reading chat needs no credentials.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional. Without it YouTube discovery uses yt-dlp on YouTube's live search page.
YOUTUBE_API_KEY=

# Claude writes the title variants. Without it, template titles are used.
ANTHROPIC_API_KEY=

# Postiz: Settings -> Public API. POSTIZ_URL is the API base:
#   Postiz Cloud: https://api.postiz.com
#   self-hosted:  http://localhost:4007/api with Postiz's docker-compose (or https://your-domain/api)
POSTIZ_API_KEY=
POSTIZ_URL=https://api.postiz.com

# Google Sheet that tracks what hits: the id is the long part of the sheet URL.
# Share the sheet with the service account's email (Editor).
GSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# Optional: Hugging Face token, only for ClipsAI's "speaker" layout (pyannote).
HF_TOKEN=
